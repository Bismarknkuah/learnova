# ── Shared ─────────────────────────────────────────────
NODE_ENV=development

# ── API ────────────────────────────────────────────────
PORT=4000
LOG_LEVEL=info
MONGO_URI=mongodb://mongo:27017/learnova
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:3000

# AI gateway (provider-agnostic)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
QDRANT_URL=http://qdrant:6333

# Payments (Ghana)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
COMMISSION_RATE=0.15
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_SUBSCRIPTION_KEY=

# ── Web ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# LiveKit (live classroom + recording)
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_RECORDINGS_BUCKET=learnova-recordings

# ── LiveKit (live classroom) ───────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_RECORDINGS_BUCKET=learnova-recordings

# ── ASR (class transcription) ──────────────────────────
ASR_PROVIDER=none
DEEPGRAM_API_KEY=

# ---- Multi-tenancy (schools renting Learnova) ----
TENANT_ISOLATION=shared          # 'shared' (default) or 'database' (DB-per-school)
MONGO_BASE_URI=                  # cluster URI without a db name, used in 'database' mode
TENANT_DB_PREFIX=learnova_
ROOT_DOMAIN=learnova.app

# ── OAuth (Google sign-in) ─────────────────────────────
GOOGLE_CLIENT_ID=                 # backend: verifies Google ID tokens
NEXT_PUBLIC_GOOGLE_CLIENT_ID=     # frontend: renders the Google button (same client ID)
