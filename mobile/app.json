{
  "expo": {
    "name": "Learnova",
    "slug": "learnova",
    "scheme": "learnova",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "backgroundColor": "#0E7C5A" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.learnova.app"
    },
    "android": {
      "package": "com.learnova.app",
      "adaptiveIcon": { "backgroundColor": "#0E7C5A" }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
